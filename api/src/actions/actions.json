  {
    "action": "PLATFORM:transcribe_meeting",
    "lib": "transcribe_meeting",
    "description": "Transcribe all WAV audio files in a directory one by one and return individual and combined transcripts",
    "icon": "mdi:microphone-multiple",
    "inputSchema": {
      "type": "object",
      "properties": {
        "directoryPath": {
          "type": "string",
          "description": "Absolute path to the directory containing .wav files."
        }
      },
      "required": ["directoryPath"]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "full_meeting_transcript": {
          "type": "string",
          "description": "Combined transcript of all audio files in order."
        },
        "speaker_transcripts": {
          "type": "array",
          "description": "Each participant's individual transcript.",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "transcript": { "type": "string" }
            },
            "required": ["id", "transcript"]
          }
        },
        "error": { "type": "string" }
      }
    }
  },
  {
    "action": "PLATFORM:merge_transcripts",
    "lib": "merge_transcripts",
    "description": "Label the main meeting transcript with speaker attribution by cross-referencing each participant's individual transcript (who said what), processed in chunks to stay within LLM output token limits",
    "icon": "mdi:text-account",
    "inputSchema": {
      "type": "object",
      "properties": {
        "full_meeting_transcript": {
          "type": "string",
          "description": "Combined transcript from transcribe_meeting, to be labeled with speakers."
        },
        "speaker_transcripts": {
          "type": "array",
          "description": "Each participant's individual transcript, from transcribe_meeting's output. Pass this array through unchanged.",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "transcript": { "type": "string" }
            },
            "required": ["id", "transcript"]
          }
        }
      },
      "required": ["full_meeting_transcript", "speaker_transcripts"]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "final_transcript": {
          "type": "string",
          "description": "Unified chronological transcript with speaker labels."
        },
        "error": { "type": "string" }
      }
    }
  },
  {
    "action": "PLATFORM:summarize_meeting_by_speaker",
    "lib": "summarize_meeting_by_speaker",
    "description": "Produce a structured meeting summary (key topics, decisions, action items) attributed by speaker ID. First summarizes each participant's individual transcript separately (small, word-capped output), then combines those short summaries plus the full transcript as background reference - keeps every LLM call's output well within token limits regardless of meeting length",
    "icon": "mdi:text-box-check",
    "inputSchema": {
      "type": "object",
      "properties": {
        "full_meeting_transcript": {
          "type": "string",
          "description": "Combined transcript from transcribe_meeting, used as background reference when combining per-speaker summaries."
        },
        "speaker_transcripts": {
          "type": "array",
          "description": "Each participant's individual transcript, from transcribe_meeting's output. Pass this array through unchanged.",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "transcript": { "type": "string" }
            },
            "required": ["id", "transcript"]
          }
        },
        "language": {
          "type": "string",
          "description": "Language for the summary output (e.g. 'tr', 'en'). Defaults to 'tr'."
        }
      },
      "required": ["full_meeting_transcript", "speaker_transcripts"]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "summary": { "type": "string" },
        "key_topics": { "type": "array", "items": { "type": "string" } },
        "decisions": { "type": "array", "items": { "type": "string" } },
        "action_items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "owner_id": { "type": "string" },
              "task": { "type": "string" }
            }
          }
        },
        "speaker_highlights": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "summary": { "type": "string" }
            }
          }
        },
        "error": { "type": "string" }
      }
    }
  },
  {
    "action": "PLATFORM:resolve_participants",
    "lib": "resolve_participants",
    "description": "Replace participant IDs with their real names, anywhere they appear (recursively) inside a text transcript or a structured summary object, using a participants list from metadata",
    "icon": "mdi:account-convert",
    "inputSchema": {
      "type": "object",
      "properties": {
        "content": {
          "description": "The transcript string or structured summary object (e.g. output of summarize_meeting_by_speaker) containing participant IDs to resolve."
        },
        "participants": {
          "type": "array",
          "description": "Array of participant objects from meeting metadata.",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" }
            },
            "required": ["id", "name"]
          }
        }
      },
      "required": ["content", "participants"]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "content": {
          "description": "The same input shape (string or object), with IDs replaced by participant names."
        },
        "error": { "type": "string" }
      }
    }
  },
