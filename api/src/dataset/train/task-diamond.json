  {
    "id": "1dcgcfde-6f1e-5a35-c6ge-7ef373396a47",
    "description": "Setup internet subscription at user's address.",
    "sessionId": "019b6e75-8a07-72f2-8adf-82cd88f6b7cc",
    "pseudocode": "BEGIN_CONTEXT \nUser.Address = GetUserAddress()\nbbk = GetBBKByAddress(User.Address)\ninventory = GetInventory(bbk)\nIF inventory.Available == TRUE THEN\n    products = GetProductBySpeed()\n    selectedProduct = WaitForUserSelection(products)\n    PortTahsis(selectedProduct.serial_number)\n    Configuration(selectedProduct.serial_number)\n    PortBaglanti(selectedProduct.assignment_id)\nEND_IF\nEND_CONTEXT\n\nEND_MESSAGE",
