{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "..",
    "outDir": "../npm/nuc",
    "declaration": true,
    "sourceMap": false,
    "removeComments": true,
    "noEmitOnError": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "../mcp/McpClient.ts"],
  "exclude": [
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/routes/test"
  ]
}
