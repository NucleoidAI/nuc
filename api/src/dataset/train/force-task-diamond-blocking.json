      "description": "The caller wants the address on policy HOM-20260204 changed to 3 Bay Tree Cottages, St Ives.",
      "knowledge": [
        {
          "type": "TEXT",
          "text": "2FA channel selection. Phone number change -> channel is email. Any other change, address included -> channel is whatsapp."
        }
      ],
      "tools": ["AS400:get_policy", "PLATFORM:two_factor", "AS400:update_policy", "PLATFORM:complete"],
      "steps": [
        {
          "action": "AS400:get_policy",
          "status": "COMPLETED",
          "parameters": { "policy_id": "HOM-20260204" },
          "result": "{\"record\": {\"POLID\": \"HOM-20260204\", \"EMAIL\": \"holder@corp.co.uk\", \"MOBILE\": \"+44 7700 900118\", \"ADDR1\": \"12 Kingsway\"}}",
          "comment": "Read the policy before changing it"
        }
      ],
      "forced_action": "PLATFORM:two_factor",
      "next_step": {
        "parameters": {
          "channel": "whatsapp",
          "recipient": { "$ref": "steps[0].result.record.MOBILE" },
          "question": "Please approve changing the address on policy HOM-20260204 to 3 Bay Tree Cottages, St Ives."
        },
        "comment": "The knowledge reserves email for phone number changes, so an address change goes over WhatsApp - recipient is the number already held on the policy (steps[0].result.record.MOBILE) via $ref, never the new value the caller gave",
