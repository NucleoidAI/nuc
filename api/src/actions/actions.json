  {
    "action": "PLATFORM:create_vm",
    "lib": "create_vm",
    "description": "Create a virtual machine (EC2 instance) on AWS. If no AMI is given, the latest Amazon Linux 2023 image is used.",
    "icon": "mdi:server-plus",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name tag for the instance."
        },
        "instanceType": {
          "type": "string",
          "description": "EC2 instance type (e.g. 't3.micro', 't3.small'). Defaults to 't3.micro'."
        },
        "amiId": {
          "type": "string",
          "description": "AMI ID to launch from. Defaults to the latest Amazon Linux 2023 AMI."
        },
        "keyName": {
          "type": "string",
          "description": "Name of an existing EC2 key pair for SSH access (optional)."
        },
        "subnetId": {
          "type": "string",
          "description": "Subnet ID to launch into (optional)."
        },
        "securityGroupIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Security group IDs to attach (optional)."
        },
        "region": {
          "type": "string",
          "description": "AWS region. Defaults to the AWS_REGION environment variable."
        }
      },
      "required": ["name"]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean" },
        "instanceId": { "type": "string" },
        "imageId": { "type": "string" },
        "instanceType": { "type": "string" },
        "state": {
          "type": "string",
          "description": "Instance state right after launch (usually 'pending')."
        },
        "privateIp": { "type": "string" },
        "publicIp": { "type": "string" },
        "availabilityZone": { "type": "string" },
        "error": { "type": "string" }
      }
    }
  },
  {
    "action": "PLATFORM:terminate_vm",
    "lib": "terminate_vm",
    "description": "Terminate a virtual machine (EC2 instance) on AWS by instance ID. Termination is permanent and cannot be undone.",
    "icon": "mdi:server-remove",
    "inputSchema": {
      "type": "object",
      "properties": {
        "instanceId": {
          "type": "string",
          "description": "The ID of the EC2 instance to terminate (e.g. 'i-0abc123def456...')."
        },
        "region": {
          "type": "string",
          "description": "AWS region the instance is in. Defaults to the AWS_REGION environment variable."
        }
      },
      "required": ["instanceId"]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean" },
        "instanceId": { "type": "string" },
        "previousState": {
          "type": "string",
          "description": "Instance state before termination (e.g. 'running')."
        },
        "currentState": {
          "type": "string",
          "description": "Instance state after the request (usually 'shutting-down')."
        },
        "error": { "type": "string" }
      }
    }
  },
  {
    "action": "PLATFORM:evaluate_metrics",
    "lib": "evaluate_metrics",
    "description": "Deterministically evaluate an OTLP resourceMetrics payload against metric reference ranges. Pass the incoming OTLP payload as 'metrics' and the reference ranges (e.g. from agent knowledge) as 'reference_ranges'. Each data point is matched to its reference by metric name and attributes, then checked against min/max bounds or an expected value. Returns the out-of-range metrics as violations.",
    "icon": "mdi:chart-bell-curve",
    "inputSchema": {
      "type": "object",
      "properties": {
        "metrics": {
          "type": ["object", "string"],
          "description": "OTLP resourceMetrics payload from the incoming message, either as a JSON object with a 'resourceMetrics' array or as a JSON string."
        },
        "reference_ranges": {
          "type": ["array", "object", "string"],
          "description": "Reference ranges to evaluate against, e.g. from agent knowledge. A list of objects with 'metric' and optional 'attributes', 'min', 'max', 'expected', 'unit'. A single range object or a JSON string is also accepted."
        }
      },
      "required": ["metrics", "reference_ranges"]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "description": "host.name from the resource attributes."
        },
        "checked": {
          "type": "number",
          "description": "Number of data points evaluated against a reference."
        },
        "hasViolations": {
          "type": "boolean",
          "description": "True when at least one metric is outside its reference range."
        },
        "violations": {
          "type": "array",
          "description": "Out-of-range metrics with observed value, allowed range and timestamp.",
          "items": {
            "type": "object",
            "properties": {
              "metric": { "type": "string" },
              "attributes": { "type": "object" },
              "value": { "type": "number" },
              "min": { "type": ["number", "null"] },
              "max": { "type": ["number", "null"] },
              "expected": { "type": "number" },
              "unit": { "type": "string" },
              "timeUnixNano": { "type": "string" }
            }
          }
        },
        "error": { "type": "string" }
      }
    }
  },
