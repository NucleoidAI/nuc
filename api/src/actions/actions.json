[
  {
    "action": "PLATFORM:llm",
    "lib": "llm",
    "description": "Send a message to the Language Model for AI processing",
    "icon": "mdi:brain",
    "inputSchema": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "description": "The message to be sent to the LLM."
        }
      },
      "required": ["message"]
    }
  },
  {
    "action": "PLATFORM:scrape_website",
    "lib": "scrapper",
    "description": "Extract data from a website URL",
    "icon": "mdi:web",
    "inputSchema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "The URL of the website to scrape."
        }
      },
      "required": ["url"]
    }
  },
  {
    "action": "PLATFORM:decision",
    "lib": "decision",
    "description": "A decision node that branches the flow based on conditions",
    "icon": "mdi:source-branch",
    "inputSchema": {
      "type": "object",
      "properties": {
        "condition": {
          "type": "string",
          "description": "The condition to be checked."
        },
        "true": {
          "type": "array",
          "description": "The actions to be executed if the condition is true."
        },
        "false": {
          "type": "array",
          "description": "The actions to be executed if the condition is false."
        }
      },
      "required": ["condition", "true", "false"]
    }
  },
  {
    "action": "PLATFORM:user_interaction",
    "lib": "interaction",
    "description": "Interact with the user and get their response",
    "icon": "mdi:account-question",
    "inputSchema": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "description": "The question to ask the user."
        }
      },
      "required": ["question"]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "answer": {
          "type": "string",
          "description": "User's answer to the question."
        }
      }
    }
  },
  {
    "action": "PLATFORM:complete",
    "description": "Mark the workflow as complete",
    "icon": "mdi:check"
  },
  {
    "action": "PLATFORM:handoff",
    "description": "Transfer this task to another agent's blueprint and continue in the same session",
    "icon": "mdi:account-arrow-right",
    "inputSchema": {
      "type": "object",
      "properties": {
        "targetAgentId": {
          "type": "string",
          "description": "The ID of the target agent to hand off to."
        },
        "targetBlueprintId": {
          "type": "string",
          "description": "The ID of the target agent's blueprint (optional)."
        },
        "context": {
          "type": "string",
          "description": "A summary of the current task context to pass to the target agent."
        }
      },
      "required": ["targetAgentId", "context"]
    }
  },
  {
    "action": "PLATFORM:ask_supervisor",
    "lib": "ask_supervisor",
    "description": "Ask a supervisor for guidance or approval",
    "icon": "mdi:account-supervisor",
    "inputSchema": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "The session ID."
        },
        "agentId": {
          "type": "string",
          "description": "The agent ID."
        },
        "question": {
          "type": "string",
          "description": "The question to ask the supervisor."
        }
      },
      "required": ["question"]
    }
  },
  {
    "action": "PLATFORM:message_user",
    "lib": "message_user",
    "description": "Send a message to the user",
    "icon": "mdi:message-text",
    "inputSchema": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "The session ID."
        },
        "agentId": {
          "type": "string",
          "description": "The agent ID."
        },
        "message": {
          "type": "string",
          "description": "The message to send to the user."
        }
      },
      "required": ["message"]
    }
  }
]
