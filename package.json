{
  "name": "nuc",
  "version": "0.0.15",
  "description": "nuc is a supervised agentic AI platform designed to automate tasks, manage workflows, and provide insights.",
  "main": "link-server",
  "author": "nuc Team",
  "private": "true",
  "scripts": {
    "predev": "rm -rf dashboard/node_modules/.vite",
    "dev:events": "bunx @canmingir/link-express@1.7.41 start",
    "dev:api": "cd ./api && bun run dev",
    "dev:dashboard": "cd ./dashboard && bun run dev",
    "dev:main": "link-server",
    "dev:tunnel": "concurrently -n \"dev,tunnel\" \"bun run dev\" \"link-tunnel\"",
    "security:report": "bun scripts/security-report/index.ts",
    "dev": "dotenv -e .env.local -- concurrently -n \"events,api,dashboard\" \"bun run dev:events\" \"bun run dev:api\" \"bun run dev:dashboard\"",
    "install:dashboard": "cd ./dashboard && bun install",
    "install:mcp": "cd ./mcp && bun install",
    "install": "bun run install:api && bun run install:dashboard && bun run install:mcp",
    "install:api": "cd ./api && bun install",
    "test:api": "cd ./api && bun run test",
    "test:dashboard": "cd ./dashboard && bun run test",
    "test": "bun run test:api && bun run test:dashboard",
    "test:e2e": "cd ./api && bun run test:e2e",
    "build": "bun run build:dashboard && bun run build:api",
    "build:dashboard": "cd ./dashboard && bun run build",
    "build:api": "cd ./api && bun run build",
    "serve:api": "cd ./api && bun server.ts",
    "serve": "concurrently -n \"main,api\" \"link-server \" \"bun run serve:api\"",
    "lint:dashboard": "cd ./dashboard && bun run lint",
    "lint": "bun run lint:dashboard",
    "typecheck:dashboard": "cd ./dashboard && bun run typecheck",
    "typecheck": "bun run typecheck:dashboard"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.1085.0",
    "@canmingir/link": "^1.2.95",
    "concurrently": "^9.1.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "dotenv-cli": "^11.0.0"
  }
}
