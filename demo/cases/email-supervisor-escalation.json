{
  "name": "Email → Supervisor Escalation",
  "description": "Customer emails about an invoice, the agent escalates to a supervisor and replies by email",
  "vars": {
    "dashboard": "http://localhost:3000/dashboard"
  },
  "indicator": { "position": "right", "size": 360 },
  "gap": 8,
  "windows": {
    "mail": { "type": "app", "app": "Microsoft Outlook" },
    "dashboard": { "type": "chrome", "url": "{{dashboard}}/" },
    "monitor": { "type": "chrome", "url": "{{dashboard}}/monitoring" },
    "knowledge": { "type": "chrome", "url": "{{dashboard}}/knowledge" }
  },
  "steps": [
    {
      "id": "customer-writes",
      "title": "Customer sends an invoice question",
      "note": "Send the prepared email from the customer account. Subject must mention \"invoice\".",
      "layout": {
        "preset": "columns",
        "panes": [{ "window": "mail" }, { "window": "dashboard" }]
      },
      "advance": [
        {
          "event": "EMAIL_RECEIVED",
          "where": { "subject": { "contains": "invoice" } },
          "capture": { "sessionId": "sessionId", "customer": "from" },
          "label": "Waiting for an email about \"invoice\""
        }
      ]
    },
    {
      "id": "agent-plans",
      "title": "Agent opens a task",
      "note": "The email became a session for {{customer}}. Point out the task plan appearing on the monitor.",
      "layout": {
        "preset": "main-left",
        "panes": [{ "window": "monitor" }, { "window": "mail" }]
      },
      "advance": [
        {
          "event": "TASK_CREATED",
          "where": { "sessionId": "{{sessionId}}" },
          "capture": { "taskId": "taskId" }
        }
      ]
    },
    {
      "id": "escalation",
      "title": "Agent asks the supervisor",
      "note": "The agent is not confident, so it escalates instead of guessing. This is hallucination control.",
      "advance": [
        {
          "event": "SUPERVISING_RAISED",
          "where": { "sessionId": "{{sessionId}}" },
          "capture": { "question": "question" }
        }
      ]
    },
    {
      "id": "supervisor-answers",
      "title": "Supervisor answers",
      "note": "Answer the question in the dashboard. The answer is saved as knowledge for next time.",
      "layout": {
        "preset": "full",
        "panes": [{ "window": "dashboard" }]
      },
      "advance": [
        {
          "event": "SUPERVISING_ANSWERED",
          "where": { "sessionId": "{{sessionId}}" }
        }
      ]
    },
    {
      "id": "reply-sent",
      "title": "Agent replies to the customer",
      "note": "The supervised answer goes back by email in the same thread.",
      "layout": {
        "preset": "main-right",
        "panes": [{ "window": "mail" }, { "window": "monitor" }]
      },
      "advance": [
        {
          "event": "EMAIL_SENT",
          "where": { "sessionId": "{{sessionId}}" }
        }
      ]
    },
    {
      "id": "learned",
      "title": "Knowledge was learned",
      "note": "Show the new knowledge entry. Next time the agent answers without escalating.",
      "layout": {
        "preset": "columns",
        "panes": [{ "window": "knowledge" }, { "window": "mail" }]
      }
    }
  ]
}
