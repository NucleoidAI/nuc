{
  "name": "Molfile Intake and SDF Conversion",
  "description": "A molfile dropped into the intake portal reaches AI Platform by webhook; the agent uploads it to S3, reads it back, converts it to SDF and writes the .sdf beside the original",
  "vars": {
    "molfileBlueprintId": "019fb220-0000-4000-8000-000000000001"
  },
  "indicator": {
    "position": "right",
    "size": 360
  },
  "gap": 8,
  "captures": [
    {
      "event": "TASK_CREATED",
      "where": {
        "blueprintId": "{{molfileBlueprintId}}"
      },
      "capture": {
        "taskId": "taskId",
        "agentId": "agentId"
      }
    },
    {
      "event": "SESSION_INITIATED",
      "where": {
        "blueprintId": "{{molfileBlueprintId}}"
      },
      "capture": {
        "sessionId": "id",
        "filename": "variables.filename"
      }
    }
  ],
  "windows": {
    "portal": {
      "type": "chrome-app",
      "app": "File Intake Portal"
    },
    "greycollar": {
      "type": "chrome-app",
      "app": "GreyCollar - Supervised AI Agents"
    },
    "s3": {
      "type": "chrome",
      "profile": "greycollar.ai",
      "url": "https://us-east-2.console.aws.amazon.com/s3/buckets/s3-demo-bucket-grey?region=us-east-2&tab=objects"
    }
  },
  "steps": [
    {
      "id": "upload-file",
      "title": "Molfile dropped into the intake portal",
      "note": "Upload the prepared .mol file in the intake portal. The portal keeps it on disk and sends its path to AI Platform by webhook.",
      "layout": {
        "panes": [
          {
            "side": "full",
            "window": "portal"
          }
        ]
      },
      "advance": [
        {
          "event": "TASK_CREATED",
          "where": {
            "blueprintId": "{{molfileBlueprintId}}"
          },
          "label": "Waiting for the task to start"
        }
      ]
    },
    {
      "id": "task-created",
      "title": "Task lands in AI Platform",
      "note": "The webhook for {{filename}} opened a Molfile Intake and SDF Conversion task. Show the task and its plan.",
      "layout": {
        "ratio": 0.5,
        "panes": [
          {
            "side": "full",
            "window": "greycollar",
            "route": "/agents/{{agentId}}?tab=tasks"
          }
        ]
      },
      "advance": [
        {
          "event": "STEP_ADDED",
          "where": {
            "taskId": "{{taskId}}",
            "action": "S3:upload_file"
          },
          "label": "Waiting for the S3 upload step"
        }
      ]
    },
    {
      "id": "s3-upload",
      "title": "Upload stored in S3 and read back",
      "note": "The agent uploads the file under docs/ in the bucket, then reads it back out for the conversion.",
      "layout": {
        "ratio": 0.5,
        "panes": [
          {
            "side": "full",
            "window": "greycollar"
          }
        ]
      },
      "advance": [
        {
          "event": "STEP_ADDED",
          "where": {
            "taskId": "{{taskId}}",
            "action": "CHEM:mol_to_sdf"
          },
          "label": "Waiting for the conversion step"
        }
      ]
    },
    {
      "id": "convert",
      "title": "MOL converted to SDF",
      "note": "The agent converts the MOL blocks read from S3 into a single SDF document.",
      "layout": {
        "panes": [
          {
            "side": "full",
            "window": "greycollar"
          }
        ]
      },
      "advance": [
        {
          "event": "STEP_ADDED",
          "where": {
            "taskId": "{{taskId}}",
            "action": "S3:put_object"
          },
          "label": "Waiting for the SDF write step"
        }
      ]
    },
    {
      "id": "sdf-written",
      "title": "SDF written beside the original",
      "note": "The agent writes the .sdf under the same key as the upload. The uploaded .mol object is never overwritten.",
      "layout": {
        "panes": [
          {
            "side": "full",
            "window": "greycollar"
          }
        ],
        "ratio": 0.5
      },
      "advance": [
        {
          "event": "TASK_COMPLETED",
          "where": {
            "taskId": "{{taskId}}"
          },
          "label": "Waiting for the task to complete"
        }
      ]
    },
    {
      "id": "done",
      "title": "Upload and SDF in the bucket",
      "note": "Refresh the S3 folder to show the original {{filename}} and its .sdf side by side, next to the completed task.",
      "layout": {
        "ratio": 0.5,
        "panes": [
          {
            "side": "full",
            "window": "s3"
          }
        ]
      }
    }
  ]
}
