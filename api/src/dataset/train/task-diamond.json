  {
    "id": "5hkjgmih-8h4g-7d57-e9jh-0igf495519d60",
    "description": "Setup internet subscription for a US residential address with full notification flow.",
    "sessionId": "029c8g97-0c29-94h4-0cfg-04ef00h8d9ee",
    "pseudocode": "BEGIN_CONTEXT \nUser.Address = GetUserAddress()\nbbk = GetBBKByAddress(User.Address)\ninventory = GetInventory(bbk)\nIF inventory.Available == TRUE THEN\n    products = GetProductBySpeed()\n    selectedProduct = WaitForUserSelection(products)\n    PortAllocation(selectedProduct.serial_number)\n    MessageUser()\n    Configuration(selectedProduct.serial_number)\n    PortConnection(selectedProduct.assignment_id)\n    Complete()\nEND_IF\nEND_CONTEXT\n\nEND_MESSAGE",
    "blueprint": {
      "id": "ca7g8022-f343-570e-a171-3992963g7f70",
      "title": "Basic Internet Subscription Setup",
      "description": "Offer internet packages based on the user's residential address and set up the selected offer.",
      "pseudocode": "BEGIN_CONTEXT\nbbk = GetBBKByAddress(User.Address)\ninventory = GetInventory(bbk)\nIF inventory.Available == TRUE THEN\n    products = GetProductBySpeed()\n    ShowProducts(products)\n    selectedProduct = WaitForUserSelection(products)\n    PortAllocation(selectedProduct.serial_number)\n    MessageUser()\n    Configuration(selectedProduct.serial_number)\n    PortConnection(selectedProduct.assignment_id)\n    Complete()\nEND_IF\nEND_CONTEXT\n\nEND_MESSAGE",
      "agentId": "00db1bd4-4829-40f2-8b99-d2e42342157e",
