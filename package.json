{
  "name": "greycollar",
  "version": "0.0.6",
  "description": "GreyCollar is a supervised agentic AI platform designed to automate tasks, manage workflows, and provide insights.",
  "main": "server.js",
  "author": "GreyCollar Team",
  "private": "true",
  "scripts": {
    "predev": " rm -rf dashboard/node_modules/.vite && cd ./mcp && npm run db:reset",
    "debug:mcp": "cd ./mcp && npm run debug",
    "dev:api": "cd ./api && npm run dev",
    "dev:dashboard": "cd ./dashboard && npm run dev",
    "dev:main": "npm start",
    "dev:inMemoryEventListener": "cd ./inMemoryEventListener && npm run dev",
    "dev": "concurrently -n \"main,api,dashboard,communication,event_listener\" \"npm start\" \"npm run dev:api\" \"npm run dev:dashboard\" \"npm run dev:communication\" \"npm run dev:inMemoryEventListener\"",
    "install:api": "cd ./api && npm install",
    "install:dashboard": "cd ./dashboard && npm install",
    "install:communication": "cd ./communication && npm install",
    "install": "npm run install:api && npm run install:dashboard",
    "test:api": "cd ./api && npm run test",
    "test:dashboard": "cd ./dashboard && npm run test",
    "test": "npm run test:api && npm run test:dashboard",
    "build": "cd ./dashboard && npm run build",
    "dev:communication": "cd ./communication && npm run dev",
    "preserve": "cd ./mcp && npm run db:reset",
    "serve": "concurrently -n \"main,api,dashboard\" \"npm start\" \"npm run dev:api\" \"npx @nucleoidai/http-server start --port 5173\"",
    "lint:dashboard": "cd ./dashboard && npm run lint",
    "lint": "npm run lint:dashboard",
    "typecheck:dashboard": "cd ./dashboard && npm run typecheck",
    "typecheck": "npm run typecheck:dashboard"
  },
  "dependencies": {
    "@canmingir/link-express": "^1.7.10",
    "@canmingir/link": "^1.2.22",
    "@modelcontextprotocol/sdk": "^1.15.1",
    "@nucleoidai/node-event": "^1.1.5",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "http-proxy-middleware": "^3.0.1"
  }
}
