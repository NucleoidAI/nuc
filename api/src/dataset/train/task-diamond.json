    "id": "2edhdfef-7g2f-6b46-d7hf-8fg484407b58",
    "description": "Process customer refund request based on order status.",
    "sessionId": "019c7f86-9b18-83g3-9beg-93de99g7c8dd",
    "pseudocode": "BEGIN_CONTEXT\norder = GetOrderById(Order.Id)\nIF order.Status == 'DELIVERED' AND order.DeliveryDate > 30_DAYS_AGO THEN\n    RefundRequest.Reject()\nELSE IF order.Status == 'DELIVERED' THEN\n    RefundRequest.Process()\n    Refund.Create(order.Amount)\n    Notification.Send(User.Email)\nEND_IF\nEND_CONTEXT\n\nEND_MESSAGE",
